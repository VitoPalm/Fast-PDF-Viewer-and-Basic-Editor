{
  "name": "fast-pdf-editor",
  "private": true,
  "version": "1.5.1",
  "description": "A high-performance, premium PDF viewer and editor.",
  "author": "Vito Palmieri <vito@example.com>",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && electron-builder --publish never",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "version:sync:git": "node scripts/sync-version.mjs --from-git",
    "version:set": "node scripts/sync-version.mjs",
    "package:dir": "npm run version:sync:git && tsc -b && vite build && electron-builder --dir --publish never",
    "test:packaged": "npm run package:dir && playwright test --config=playwright.packaged.config.ts",
    "preview": "vite preview",
    "electron:build": "npm run version:sync:git && tsc -b && vite build && electron-builder --publish always",
    "electron:build:win": "npm run version:sync:git && vite build && electron-builder --win",
    "electron:build:mac": "npm run version:sync:git && vite build && electron-builder --mac",
    "electron:build:linux": "npm run version:sync:git && vite build && electron-builder --linux"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@okathira/ghostpdl-wasm": "^1.1.0",
    "@types/uuid": "^10.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.8.69",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VitoPalm/Fast-PDF-Viewer-and-Basic-Editor.git"
  },
  "build": {
    "appId": "com.vitopalmieri.fastpdf",
    "productName": "Antigravity PDF",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "extraResources": [
      {
        "from": "node_modules/@okathira/ghostpdl-wasm/dist/gs.wasm",
        "to": "gs.wasm"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
